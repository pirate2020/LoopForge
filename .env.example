# ./start.sh (or bash scripts/configure.sh) generates .env with unique local database/session secrets.
# Platform image: empty uses the GHCR release pinned in compose.yaml. Prefer an @sha256: digest when overriding.
# ./start.sh times ghcr.io and ghcr.nju.edu.cn. MIRROR=ghcr.io or MIRROR=ghcr.nju.edu.cn forces one host. See README.zh-CN.md.
LOOPFORGE_IMAGE=
# Source build of this checkout (./start.sh dev writes this line; ./start.sh release removes it):
# COMPOSE_FILE=compose.yaml:compose.dev.yaml
AGENTFLOW_HTTP_PORT=8090
AGENTFLOW_MYSQL_DSN=loopforge:REPLACE_ME@tcp(127.0.0.1:33315)/loopforge
AGENTFLOW_SESSION_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
AGENTFLOW_AUTH_REQUIRED=true
LOOPFORGE_DB_PASSWORD=REPLACE_ME
LOOPFORGE_DB_ROOT_PASSWORD=REPLACE_ME
LOOPFORGE_MYSQL_PORT=33315
# Optional public address reachable from execution containers/runners:
AGENTFLOW_PLATFORM_MCP_URL=
# Optional managed Git and TAPD web hosts, with a port if required.
AGENTFLOW_GONGFENG_HOST=
AGENTFLOW_TAPD_HOST=
# Optional deployment-level credential for a configured tracker MCP.
AGENTFLOW_MCP_TOKEN=
# Optional model IDs available to your CodeBuddy account (comma-separated):
AGENTFLOW_ASSISTANT_MODELS=
AGENTFLOW_ASSISTANT_MODEL=
# OAuth 2.0 single sign-on (authorization code). Register
# <public-url>/api/auth/iam/callback with the OAuth2 application first.
# Leave empty to keep password login only.
AGENTFLOW_IAM_AUTHORIZE_URL=
AGENTFLOW_IAM_TOKEN_URL=
AGENTFLOW_IAM_USERINFO_URL=
AGENTFLOW_IAM_CLIENT_ID=
AGENTFLOW_IAM_CLIENT_SECRET=
# Space/comma-separated scopes, e.g. "openid profile email"; empty lets the provider decide.
AGENTFLOW_IAM_SCOPES=
# Fixed public callback; recommended behind a reverse proxy.
AGENTFLOW_IAM_REDIRECT_URL=
AGENTFLOW_IAM_PROVIDER_NAME=IAM
AGENTFLOW_IAM_SUBJECT_CLAIM=sub
AGENTFLOW_IAM_LOGIN_CLAIM=preferred_username
AGENTFLOW_IAM_NAME_CLAIM=name
# client_secret_basic (default) or client_secret_post.
AGENTFLOW_IAM_TOKEN_AUTH_METHOD=client_secret_basic
# signup (default) | always | never
AGENTFLOW_IAM_AUTO_PROVISION=signup
# Bind an OAuth2 identity to an existing platform account with the same login
# name. Set false to reject the collision instead.
AGENTFLOW_IAM_LINK_EXISTING=true
# Optional comma-separated CIDRs allowed for control-plane approval review / model probe gateways (e.g. 10.0.0.0/8):
AGENTFLOW_APPROVAL_EGRESS_ALLOW_CIDRS=
# Optional platform path to administrator-verified SSH host keys. See docs/deployment.md.
AGENTFLOW_GIT_SSH_KNOWN_HOSTS=
# Worker separation, installed runners and preview settings retain AGENTFLOW_ names.
# See docs/deployment.md. Production HTTPS: AGENTFLOW_SECURE_COOKIES=true.
